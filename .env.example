# Провайдер LLM: claude или gigachat
LLM_PROVIDER=claude

# API-ключ Anthropic Claude
CLAUDE_API_KEY=your_claude_api_key_here

# API-ключ GigaChat (опционально)
GIGACHAT_API_KEY=your_gigachat_api_key_here

# Telegram Bot Token от @BotFather
TELEGRAM_TOKEN=your_telegram_bot_token_here

# ID чата для отправки дайджеста
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Путь к векторной БД ChromaDB
CHROMA_DB_PATH=./chroma_db

# Путь к SQLite для истории диалогов
SQLITE_DB_PATH=./kpi_pulse.db

# Путь к SQLite-журналу взаимодействий
LOG_DB_PATH=./kpi_pulse_logs.db

# Максимальное количество строк в датасете
MAX_ROWS=5000
